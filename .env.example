# Supabase del proyecto DentaMeet (Settings → API). Sin estas dos variables la app
# corre en "modo vitrina": landing y páginas públicas funcionan, cuentas no.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Solo desarrollo: `npm run dev:demo` simula un backend en memoria para recorrer las rutas privadas.
# VITE_DEMO_MODE=true
